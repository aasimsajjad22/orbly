<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Orbly{% endblock %}</title>

    {# importmap() outputs the AssetMapper import map plus the entrypoint.
       No build step, no node_modules — the browser loads ES modules
       directly, and Symfony handles versioning and preloading. #}
    {{ importmap('app') }}
</head>
<body class="h-full text-slate-800 antialiased">

{% if app.user %}
    <header class="border-b border-slate-200 bg-white">
        <nav class="mx-auto flex max-w-2xl items-center justify-between px-4 py-3">
            <a href="{{ path('app_feed') }}" class="text-lg font-semibold tracking-tight">Orbly</a>

            <div class="flex items-center gap-5 text-sm">
                <a href="{{ path('app_feed') }}" class="hover:text-slate-900">Feed</a>
                <a href="{{ path('app_friends') }}" class="hover:text-slate-900">Friends</a>
                <a href="{{ path('app_profile', { id: app.user.id }) }}" class="hover:text-slate-900">
                    {{ app.user.displayName }}
                </a>
                <a href="{{ path('app_logout') }}" class="text-slate-500 hover:text-slate-900">Log out</a>
            </div>
        </nav>
    </header>
{% endif %}

<main class="mx-auto max-w-2xl px-4 py-8">
    {# Flash messages: one-shot notices stored in the session.
           Reading them here removes them, so they show exactly once. #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 rounded-md px-4 py-3 text-sm
                    {{ label == 'error'
            ? 'bg-red-50 text-red-800 ring-1 ring-red-200'
            : 'bg-emerald-50 text-emerald-800 ring-1 ring-emerald-200' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

</body>
</html>
