<div {{ attributes }}>
    {% set state = this.state %}

    {% if state == 'friends' %}
        <span class="text-xs text-slate-400">Friends</span>

    {% elseif state == 'sent' %}
        <span class="text-xs text-slate-400">Request sent</span>

    {% elseif state == 'incoming' %}
        {# They already asked us — point at the friends page rather than
           creating a second request. The service would auto-accept, but
           showing the real action is clearer. #}
        <a href="{{ path('app_friends') }}" class="text-xs font-medium text-slate-900 hover:underline">
            Respond to request
        </a>

    {% else %}
        <button
            data-action="live#action"
            data-live-action-param="send"
            class="rounded-md border border-slate-300 px-3 py-1 text-xs font-medium hover:bg-slate-50">
            Add friend
        </button>
    {% endif %}

    {% if this.error %}
        <p class="mt-1 text-xs text-red-600">{{ this.error }}</p>
    {% endif %}
</div>
