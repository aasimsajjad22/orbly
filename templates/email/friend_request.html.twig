{% extends 'email/base.html.twig' %}

{% block subject %}{{ senderName }} sent you a friend request{% endblock %}

{% block content %}
    <h1>New friend request</h1>

    <p>Hi {{ recipientName }},</p>

    <p><strong>{{ senderName }}</strong> would like to connect with you on Orbly.</p>

    <p>
        <a href="{{ friendsUrl }}" class="button">View request</a>
    </p>
{% endblock %}
