{% extends 'email/base.html.twig' %}

{% block subject %}Confirm your Orbly account{% endblock %}

{% block content %}
    <h1>Confirm your email address</h1>

    <p>Hi {{ displayName }},</p>

    <p>Welcome to Orbly. Click the button below to activate your account.</p>

    <p>
        <a href="{{ signedUrl }}" class="button">Confirm my email</a>
    </p>

    <p class="muted">
        This link expires in {{ expiresInMinutes }} minutes.
    </p>

    {# Some clients strip or mangle links, and some people copy rather
       than click. Always show the raw URL as a fallback. #}
    <p class="muted break">
        Or paste this into your browser:<br>
        {{ signedUrl }}
    </p>

    <p class="muted">
        If you didn't create an Orbly account, you can ignore this email.
    </p>
{% endblock %}
