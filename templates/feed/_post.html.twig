{# A single post card.
   Kept in its own template so the feed, the profile page, and the
   Live Component in chunk 4 all render posts identically. #}
<article class="rounded-lg border border-slate-200 bg-white p-4">
    <div class="mb-2 flex items-baseline justify-between">
        <div class="flex items-baseline gap-2">
            <span class="font-medium">{{ post.author.displayName }}</span>

            {% if post.visibility.value != 'public' %}
                {# Small badge so the author can see who can read this. #}
                <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-500">
                    {{ post.visibility.value }}
                </span>
            {% endif %}
        </div>

        {# |ago is not built in — this is the "time ago" filter from
           twig/intl-extra if installed. Falling back to a plain date
           keeps it simple for now. #}
        <time class="text-xs text-slate-400" datetime="{{ post.createdAt|date('c') }}">
            {{ post.createdAt|date('j M, H:i') }}
        </time>
    </div>

    <p class="whitespace-pre-wrap text-sm leading-relaxed">{{ post.content }}</p>

    <div class="mt-3 flex items-center gap-4 text-sm text-slate-500">
        {# Static for now — chunk 4 turns these into Live Component
           buttons that update without a page load. #}
        <span>♥ {{ post.likeCount }}</span>
        <span>💬 {{ post.commentCount }}</span>

        {% if post.edited %}
            <span class="text-xs text-slate-400">edited</span>
        {% endif %}
    </div>
</article>
