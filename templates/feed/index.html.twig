{% extends 'base.html.twig' %}

{% block title %}Feed · Orbly{% endblock %}

{% block body %}

    {# ---- Composer ---- #}
    <form method="post" action="{{ path('app_post_create') }}"
          class="mb-6 rounded-lg border border-slate-200 bg-white p-4">

    <textarea name="content" rows="3" required
              maxlength="{{ characterLimit }}"
              placeholder="What's happening?"
              class="w-full resize-none border-0 p-0 text-sm placeholder:text-slate-400
                     focus:outline-none focus:ring-0"></textarea>

        <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
            <select name="visibility"
                    class="rounded-md border-slate-300 py-1 pl-2 pr-7 text-xs text-slate-600">
                <option value="public">Public</option>
                <option value="friends">Friends only</option>
                <option value="private">Private</option>
            </select>

            <div class="flex items-center gap-3">
            <span class="text-xs text-slate-400">
                {{ characterLimit }} max{% if not isPro %} · <a href="#" class="underline">Pro gives 10,000</a>{% endif %}
            </span>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('post') }}">

                <button type="submit"
                        class="rounded-md bg-slate-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-slate-700">
                    Post
                </button>
            </div>
        </div>
    </form>

    {# ---- Feed ---- #}
    {% if posts is empty %}
        <div class="rounded-lg border border-dashed border-slate-300 p-8 text-center">
            <p class="text-sm text-slate-500">Nothing here yet.</p>
            <p class="mt-1 text-xs text-slate-400">Posts from your friends will show up here.</p>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for post in posts %}
                {{ include('feed/_post.html.twig', { post: post }) }}
            {% endfor %}
        </div>

        {% if nextCursor %}
            <div class="mt-6 text-center">
                {# A plain link. Turbo intercepts the click and swaps the page
               without a full reload. Chunk 7 replaces this with React
               infinite scroll that appends instead of replacing. #}
                <a href="{{ path('app_feed', { cursor: nextCursor }) }}"
                   class="inline-block rounded-md border border-slate-300 bg-white px-4 py-2 text-sm
                      font-medium hover:bg-slate-50">
                    Load older posts
                </a>
            </div>
        {% endif %}
    {% endif %}

{% endblock %}
