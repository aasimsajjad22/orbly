{% extends 'base.html.twig' %}

{% block title %}Subscription · Orbly{% endblock %}

{% block body %}
    <h1 class="mb-6 text-xl font-semibold tracking-tight">Subscription</h1>

    {% if subscription and subscription.pro %}
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-medium">Orbly Pro</p>
                    <p class="mt-1 text-sm text-slate-500">
                        {% if subscription.cancelAtPeriodEnd %}
                            {# The state most implementations get wrong:
                               cancelled, but still paid up. #}
                            Cancels on {{ subscription.currentPeriodEnd|date('j M Y') }}
                        {% else %}
                            Renews on {{ subscription.currentPeriodEnd|date('j M Y') }}
                        {% endif %}
                    </p>
                </div>

                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
                    {{ subscription.status.value }}
                </span>
            </div>

            <ul class="mt-4 space-y-1 border-t border-slate-100 pt-4 text-sm text-slate-600">
                <li>Posts up to 10,000 characters</li>
            </ul>

            {# data-turbo="false" so the browser navigates to Stripe
               normally instead of Turbo trying to fetch it. #}
            <form method="post" action="{{ path('app_subscription_portal') }}"
                  data-turbo="false" class="mt-4">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('portal') }}">
                <button class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium hover:bg-slate-50">
                    Manage billing
                </button>
            </form>
        </div>
    {% else %}
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="font-medium">Orbly Free</p>
            <p class="mt-1 text-sm text-slate-500">Posts up to 2,000 characters.</p>

            <div class="mt-5 rounded-md bg-slate-50 p-4">
                <p class="font-medium">Upgrade to Pro</p>
                <ul class="mt-2 space-y-1 text-sm text-slate-600">
                    <li>Posts up to 10,000 characters</li>
                </ul>

                <form method="post" action="{{ path('app_subscription_checkout') }}"
                      data-turbo="false" class="mt-4">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('checkout') }}">
                    <button class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
                        Upgrade
                    </button>
                </form>

                <p class="mt-3 text-xs text-slate-400">
                    Test mode — use card 4242 4242 4242 4242.
                </p>
            </div>
        </div>
    {% endif %}
{% endblock %}
